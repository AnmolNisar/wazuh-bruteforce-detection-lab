<!--
  Custom rules for the Wazuh Brute-Force Detection Lab.
  Install path on the Wazuh server: /var/ossec/etc/rules/local_rules.xml
  Custom rule IDs must be in the 100000-120000 range.
-->

<!-- ===== SSH: extra visibility on top of the built-in sshd rules ===== -->
<group name="local,sshd,authentication_success,">

  <!-- 5715 = built-in "sshd: authentication success" -->
  <rule id="100100" level="10">
    <if_sid>5715</if_sid>
    <user>^root$</user>
    <description>SSH: successful login as root from $(srcip).</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

  <rule id="100101" level="8">
    <if_sid>5715</if_sid>
    <time>6 pm - 8 am</time>
    <description>SSH: successful login by $(dstuser) outside business hours from $(srcip).</description>
    <mitre>
      <id>T1078</id>
    </mitre>
  </rule>

</group>

<!-- ===== myapp: custom application log detections ===== -->
<group name="local,myapp,authentication,">

  <rule id="100110" level="0">
    <decoded_as>myapp</decoded_as>
    <description>myapp: event grouped.</description>
  </rule>

  <rule id="100111" level="5">
    <if_sid>100110</if_sid>
    <action>LOGIN_FAILED</action>
    <description>myapp: failed login for $(dstuser) from $(srcip).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100112" level="3">
    <if_sid>100110</if_sid>
    <action>LOGIN_SUCCESS</action>
    <description>myapp: successful login for $(dstuser) from $(srcip).</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <!-- Correlation: 5 failures from the same IP within 60 seconds -->
  <rule id="100113" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100111</if_matched_sid>
    <same_srcip />
    <description>myapp: brute force - multiple failed logins from $(srcip).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

</group>
